# Annotateurs du dataset (gpt-6-luna, gpt-5.6-luna, zai-glm-5-3-flash) et agents (Mistral)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Banc des annotateurs (utils/llm_bench) : modèles Claude
ANTHROPIC_API_KEY=

# Optionnel
# Relais de tout le trafic YouTube, si YouTube bloque l'IP de la machine (VPS) : tunnel SSH vers une
# machine non bloquée (ssh -N -D 127.0.0.1:1080 …) ou proxy résidentiel http://utilisateur:mdp@hote:port
# YT_PROXY=socks5://127.0.0.1:1080
# VIDEO_SOURCE_DATA_DIR=./data
# FFMPEG_BIN=ffmpeg

# Embeddings sur un GPU Modal au lieu du CPU de la machine (model_training_pipeline/embed_modal.py).
# Jeton : modal.com/settings/tokens ; sans ces deux lignes, Modal lit ~/.modal.toml (modal setup).
# EMBED_GPU=modal
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
