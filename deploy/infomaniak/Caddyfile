# VPS Infomaniak (179.237.98.117) : portfolios statiques. Copié dans /etc/caddy/Caddyfile
# à la main (pas de déploiement automatique sur ce serveur), puis `sudo systemctl reload caddy`.
# Les sites sont des copies partielles des dépôts GitHub publics dans /srv/<dépôt>, tenues à jour
# par site-pull@<dépôt>.timer (voir site-pull@.service et site-pull@.timer à côté).

(site_statique) {
	encode zstd gzip
	file_server
	# Les copies sont des dépôts git : rien de ce qui commence par un point n'est servi.
	@cache path_regexp (^|/)\.
	respond @cache 404
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Portfolio principal (dépôt tangmomb/portfolio, branche main).
tanguym.fr {
	root * /srv/portfolio
	import site_statique
}

www.tanguym.fr {
	redir https://tanguym.fr{uri} permanent
}

# Portfolio des projets IA (dépôt tangmomb/portfolio_ia, branche master).
portfolio-ia.tanguym.fr {
	root * /srv/portfolio_ia
	import site_statique
}
