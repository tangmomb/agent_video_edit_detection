# Point d'entrée public du panneau : HTTPS automatique, un chemin par outil.
# Copié dans /etc/caddy/Caddyfile. Toutes les pages sont publiques : les envois de vidéos (modèle,
# saut d'images) sont bornés par interface/quota.py (taille, durée, nombre par IP et par jour).
agent-video-edit-detection.tanguym.fr {
	encode gzip

	# Envoi de vidéos : un peu au-dessus des 500 Mo d'interface/quota.py, qui répond le premier
	# avec un message lisible.
	request_body {
		max_size 550MB
	}

	# Sans la barre finale, les adresses relatives des pages sortiraient du chemin de l'outil.
	redir /runs /runs/
	redir /conversations /conversations/
	redir /modele /modele/
	redir /dataset /dataset/
	redir /saut /saut/

	handle_path /runs/* {
		reverse_proxy 127.0.0.1:8830
	}
	handle_path /conversations/* {
		reverse_proxy 127.0.0.1:8820
	}
	handle_path /modele/* {
		reverse_proxy 127.0.0.1:8780
	}
	handle_path /dataset/* {
		reverse_proxy 127.0.0.1:8800
	}
	handle_path /saut/* {
		reverse_proxy 127.0.0.1:8810
	}
	# Le panneau et ses pages statiques (arbre des agents, parcours).
	handle {
		reverse_proxy 127.0.0.1:8770
	}
}

# rag_ionis (dépôt tangmomb/rag_ionis) : ses conteneurs Docker n'écoutent que sur 127.0.0.1,
# l'API de production sur 8006 et celle de préproduction (contrôle Golden Dataset) sur 8007.
ionis.tanguym.fr {
	encode zstd gzip

	handle_path /staging/* {
		reverse_proxy 127.0.0.1:8007
	}
	handle {
		reverse_proxy 127.0.0.1:8006
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Beszel (deploy/beszel) : surveillance du VPS. Le hub n'écoute que sur 127.0.0.1:8090 ; l'accès est
# protégé par le compte administrateur créé dans son interface.
monitor.tanguym.fr {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Rapport du projet fine-tuning (dépôt public tangmomb/fine-tuning) : pages statiques servies depuis
# une copie partielle limitée à 00_compte_rendu, tenue à jour par fine-tuning-pull.timer.
fine-tuning.tanguym.fr {
	encode zstd gzip
	root * /srv/fine-tuning/00_compte_rendu
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
